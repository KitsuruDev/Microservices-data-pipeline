{
  "name": "mongodb-sink-connector",
  "config": {
    "connector.class": "com.mongodb.kafka.connect.MongoSinkConnector",
    "tasks.max": "1",
    "topics": "dbserver.public.university,dbserver.public.institute,dbserver.public.department,dbserver.public.specialty,dbserver.public.department_specialties",
    "connection.uri": "mongodb://admin:admin123@mongodb-server:27017",
    "database": "testdb",
    "collection": "universities",
    "change.data.capture.handler": "com.example.UniversityCdcHandler",
    "errors.tolerance": "all",
    "errors.log.enable": true
  }
}