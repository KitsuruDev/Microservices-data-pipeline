{
  "name": "elasticsearch-sink-connector",
  "config": {
    "connector.class": "io.lenses.streamreactor.connect.elastic7.ElasticSinkConnector",
    "tasks.max": "1",
    "topics": "dbserver.public.lecture_material, dbserver.public.lecture, dbserver.public.lecture_course",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "transforms": "unwrap,cdc",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "none",
    "transforms.cdc.type": "com.example.LectureMaterialCdcHandler",
    "connect.elastic.protocol": "http",
    "connect.elastic.hosts": "elasticsearch-server",
    "connect.elastic.port": "9200",
    "connect.elastic.cluster.name": "elasticsearch",
    "connect.elastic.use.http.username": "elastic",
    "connect.elastic.use.http.password": "elastic_pass123",
    "connect.elastic.kcql": "INSERT INTO lecture_material SELECT * FROM dbserver.public.lecture_material PK id PROPERTIES ('behavior.on.null.values'='DELETE'); INSERT INTO dummy_lecture SELECT * FROM dbserver.public.lecture; INSERT INTO dummy_course SELECT * FROM dbserver.public.lecture_course",
    "connect.elastic.delete.enabled": "true",
    "connect.elastic.error.policy": "NOOP",
    "connect.elastic.max.buffered.records": "100",
    "connect.elastic.flush.timeout.ms": "5000",
    "errors.tolerance": "all",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true"
  }
}